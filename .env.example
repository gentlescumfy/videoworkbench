PORT=5173
# Local-only by default. Do not expose this single-user prototype publicly.
HOST=127.0.0.1
# Optional provider adapter. See README for the JSON contract.
GENERATION_ENDPOINT=
GENERATION_API_KEY=
GENERATION_PROVIDER_NAME=
# Public HTTPS root serving /uploads and /assets, only when you host those images.
# Agnes Video 2.5 cannot fetch localhost or Base64 reference images.
GENERATION_MEDIA_BASE_URL=
# Required by tldraw for a deployed production site. Localhost works without a key.
VITE_TLDRAW_LICENSE_KEY=
